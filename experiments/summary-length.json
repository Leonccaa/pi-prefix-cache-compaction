{
  "name": "summary-length",
  "description": "example of a non-incremental experiment: summary token cap 16k vs 6k (does a tight cap cause fallbacks?)",
  "endpoint": {
    "provider": "my-provider",
    "model": "my-model",
    "baseUrl": "http://127.0.0.1:8000",
    "modelId": "my-served-model-name",
    "apiKeyEnv": "LLM_API_KEY"
  },
  "session": {
    "cycles": 2,
    "rows": 600,
    "thinking": "off"
  },
  "arms": [
    {
      "name": "cap16k",
      "config": {
        "maxSummaryTokens": 16000
      }
    },
    {
      "name": "cap6k",
      "config": {
        "maxSummaryTokens": 6000
      }
    }
  ],
  "repeats": 1,
  "compare": {
    "baseline": "cap16k",
    "candidate": "cap6k"
  },
  "accept": {
    "faster": false
  }
}
